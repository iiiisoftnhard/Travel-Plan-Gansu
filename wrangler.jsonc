{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "travel-plan-gansu",
  "main": "./index.js",
  "compatibility_date": "2026-09-25",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "travel-plan-gansu-db",
      "database_id": "badefb00-e6e3-4392-b749-8d76fe2f2237"
    }
  ]
}
